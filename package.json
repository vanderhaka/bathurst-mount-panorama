    "track:build": "node scripts/build-track-data.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
